# Ghostnet Backend Environment Variables
# Copy this file to .env and update with your values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/ghostnet
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ghostnet

# JWT Secret for authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Model Configuration
USE_MOCK_MODELS=True  # Set to False when using actual ML models
MODEL_DEVICE=cpu  # or 'cuda' for GPU

# Optional: Cloud Storage (for audio/image files)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=

# Optional: Hugging Face API Key (for transformer models)
# HUGGINGFACE_API_KEY=









